{
  "name": "bringazol-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Bringazol - kerekparmuhely, Abda. Statikus oldal + Netlify Functions a keszlet kezelesehez.",
  "scripts": {
    "build": "node build-functions.mjs",
    "login": "npx --yes netlify-cli login",
    "link": "npx --yes netlify-cli link",
    "jelszo": "npx --yes netlify-cli env:set ADMIN_PASSWORD",
    "jelszo-ellenorzes": "npx --yes netlify-cli env:list",
    "deploy": "npx --yes netlify-cli deploy --prod --dir=deploy --functions=netlify/functions --skip-functions-cache"
  },
  "dependencies": {
    "@netlify/blobs": "^8.1.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "sharp": "^0.35.3"
  }
}
